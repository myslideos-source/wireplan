# Supabase (§79) — leave unset to run on local mock data (src/lib/mock-data.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini — powers the real KI-Grundrissanalyse (/api/analyze-plan).
# Get a key at https://aistudio.google.com/apikey. Server-side only, never
# exposed to the client. Without it, uploading a plan for real analysis
# returns a clear error instead of silently falling back to demo data.
GEMINI_API_KEY=

# Stripe (§76) — not wired up yet
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Feature flags (§86) — "true"/"1" to enable, "false"/"0" to disable.
# Leave a line out entirely (don't set it to an empty value) to fall back to
# that flag's built-in default in src/lib/feature-flags.ts — an env var that
# exists but is empty is NOT the same as unset and will NOT fall back.
# AI_PLAN_ANALYSIS defaults to true (Phase 2 is implemented) — uncomment to disable:
# NEXT_PUBLIC_FEATURE_AI_PLAN_ANALYSIS=false
# AI_REVIEW defaults to true (Phase 4 is implemented) — uncomment to disable:
# NEXT_PUBLIC_FEATURE_AI_REVIEW=false
# ELECTRICAL_EDITOR defaults to true (Phase 5 is implemented) — uncomment to disable:
# NEXT_PUBLIC_FEATURE_ELECTRICAL_EDITOR=false
NEXT_PUBLIC_FEATURE_CABLE_ROUTING=false
NEXT_PUBLIC_FEATURE_LOXONE=false
NEXT_PUBLIC_FEATURE_MATERIAL_CALCULATION=false
NEXT_PUBLIC_FEATURE_PDF_EXPORT=false
NEXT_PUBLIC_FEATURE_CONSTRUCTION_MODE=false
